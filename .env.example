# =============================================================================
# NexusScan — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values you need.
#
#   cp .env.example .env
#
# .env is loaded automatically by app.py.
#
# ALL variables are optional — the app runs without any of them, but the
# AI report will fall back to a deterministic rule-based output.
# =============================================================================


# -----------------------------------------------------------------------------
# LLM — AI Plain-English Report Layer
# -----------------------------------------------------------------------------
# NexusScan supports three providers. Pick one and set the matching API key.
# If LLM_API_KEY is not set, a fully deterministic rule-based report is shown.

# Provider selection: groq | openai | gemini   (default: groq)
LLM_PROVIDER=groq

# API key for the chosen provider.
#   Groq  → https://console.groq.com/keys        (free tier available)
#   OpenAI→ https://platform.openai.com/api-keys
#   Gemini→ https://aistudio.google.com/apikey   (free tier available)
LLM_API_KEY=

# Model override — leave blank to use the provider's recommended default:
#   groq   → llama-3.1-8b-instant
#   openai → gpt-4o-mini
#   gemini → gemini-2.5-flash
LLM_MODEL=

# HTTP timeout for LLM API calls, in seconds.  (default: 12)
LLM_TIMEOUT=12


# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
# Maximum number of /analyze requests allowed per IP address per minute.
# (default: 30)

RATE_LIMIT_RPM=30

# Optional Redis URL for cross-instance/cross-worker rate limiting.
# Format: redis://[:password@]host[:port][/db]
#
# Without this, each Gunicorn/Vercel worker tracks its own counter independently
# (effective limit becomes RPM × num_workers).  Redis unifies the counter across
# all instances.
#
# Examples:
#   REDIS_URL=redis://localhost:6379
#   REDIS_URL=redis://:mypassword@redis.example.com:6379/0
#   REDIS_URL=rediss://...  (TLS)
REDIS_URL=


# -----------------------------------------------------------------------------
# CORS — Cross-Origin Resource Sharing
# -----------------------------------------------------------------------------
# Controls the Access-Control-Allow-Origin header returned by /analyze.
#
# Default (*) allows any origin — acceptable because /analyze requires a JSON
# body and no credentials/cookies are used.
#
# Lock this down to your frontend domain if you serve it elsewhere:
#   ALLOWED_ORIGIN=http://localhost:5000
ALLOWED_ORIGIN=*


# -----------------------------------------------------------------------------
# Proxy / IP Detection
# -----------------------------------------------------------------------------
# Set to "false" to always use request.remote_addr and ignore X-Forwarded-For.
# Keep "true" (default) when running behind Vercel, Nginx, or Cloudflare so
# the real client IP is used for rate limiting.

TRUST_PROXY=true


# -----------------------------------------------------------------------------
# SSRF Protection Override  ⚠️  DEVELOPMENT / TESTING ONLY
# -----------------------------------------------------------------------------
# Set to "true" to disable SSRF checks and allow scanning of localhost,
# 192.168.x.x, and other internal addresses.
#
# ⚠️  NEVER set this to true in production — it exposes internal network
#     infrastructure to any user who submits a URL.

ALLOW_INTERNAL_TARGETS=false
