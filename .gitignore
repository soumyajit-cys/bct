# =============================================================================
# NexusScan — .gitignore
# =============================================================================


# =============================================================================
# 🔑 SECRETS & ENVIRONMENT  (never commit real credentials)
# =============================================================================

.env
.env.local
.env.production
.env.staging
.env.*.local

# Keep the template — it has no real values
!.env.example


# =============================================================================
# 🐍 PYTHON
# =============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc

# C extensions
*.so

# Distribution / packaging
dist/
build/
*.egg
*.egg-info/
.eggs/
MANIFEST
*.whl

# pip
pip-log.txt
pip-delete-this-directory.txt

# setuptools / wheel
.installed.cfg
*.spec

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# pyright / pylance
pyrightconfig.json

# Ruff / flake8 / pylint
.ruff_cache/
.flake8
.pylintrc.cache

# Type stubs
*.pyi.bak


# =============================================================================
# 🧪 TESTING & COVERAGE
# =============================================================================

.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
nosetests.xml
test-results/
*.test.log


# =============================================================================
# 🌐 VIRTUAL ENVIRONMENTS
# =============================================================================

venv/
.venv/
env/
ENV/
.env_folder/
virtualenv/
.python-version


# =============================================================================
# 🚀 VERCEL / DEPLOYMENT
# =============================================================================

.vercel/
.output/
.next/           # if Next.js is ever added
.nuxt/


# =============================================================================
# 📦 NODE / NPM  (frontend tooling, if used)
# =============================================================================

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock
.pnpm-debug.log*


# =============================================================================
# 💻 IDE & EDITOR
# =============================================================================

# VS Code
.vscode/
*.code-workspace

# JetBrains (PyCharm, WebStorm, etc.)
.idea/
*.iml
*.iws
*.ipr
out/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim / Neovim
*.swp
*.swo
*.swn
*~
.netrwhist

# Emacs
\#*\#
.\#*


# =============================================================================
# 🖥️ OPERATING SYSTEM
# =============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~


# =============================================================================
# 📋 LOGS & TEMPORARY FILES
# =============================================================================

*.log
*.log.*
logs/
*.tmp
*.temp
*.bak
*.orig
*.rej


# =============================================================================
# 🔒 CERTIFICATES & KEYS  (extra safety net)
# =============================================================================

*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der
